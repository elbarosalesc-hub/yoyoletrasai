{
  "framework": "vite",
  "functions": {
    "api/ai/generate.js": { "maxDuration": 120 },
    "api/owner/control.js": { "maxDuration": 30 },
    "api/owner/factory.js": { "maxDuration": 120 },
    "api/cron/innovation-scan.js": { "maxDuration": 300 },
    "api/cron/resource-factory.js": { "maxDuration": 300 },
    "api/storage/uploads.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/innovation-scan", "schedule": "0 6 1 * *" },
    { "path": "/api/cron/resource-factory", "schedule": "0 7 * * 1" }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
