# Supabase public configuration
# Copy this file to apps/web/.env.local for local development.
# The URL identifies the linked project and is not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://xpcywpvrveweynqvudcr.supabase.co

# Obtain the publishable key from Supabase Project Settings > API.
# It is safe for browser use only because all exposed tables enforce RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this variable to the browser or commit its real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only identity override for the YoYoLetrasAI owner account.
# Leave the real address in the deployment environment rather than hard-coding it in new code.
YOYO_OWNER_EMAIL=

# YOYO IA routing. Keep provider/gateway credentials server-side only.
AI_GATEWAY_API_KEY=
YOYO_AI_MODEL_ESSENTIAL=
YOYO_AI_MODEL_ADVANCED=
YOYO_AI_MODEL_INSTITUTION=
YOYO_AI_MODEL_OWNER=
