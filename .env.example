# Supabase public configuration
# Copy this file to apps/web/.env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=https://xpcywpvrveweynqvudcr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this variable to the browser or commit its real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used to authorize governed scheduled automation routes.
CRON_SECRET=

# Server-only identity override for the YoYoLetrasAI owner account.
YOYO_OWNER_EMAIL=

# Cloudflare AI runtime.
# Create an API token with the minimum Workers AI permissions needed by the runtime.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional full override. If omitted, YOYO builds the Cloudflare REST endpoint from CLOUDFLARE_ACCOUNT_ID.
# Example: https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1/chat/completions
YOYO_AI_GATEWAY_URL=

# YOYO IA model routing. Use Cloudflare-supported provider/model identifiers.
YOYO_AI_MODEL_ESSENTIAL=google-ai-studio/gemini-2.5-flash
YOYO_AI_MODEL_ADVANCED=anthropic/claude-sonnet-4-5
YOYO_AI_MODEL_INSTITUTION=anthropic/claude-sonnet-4-5
YOYO_AI_MODEL_OWNER=openai/gpt-5.2

# Provider-neutral billing readiness.
# These values only expose that an external billing portal exists; they do not mark recurring billing or webhooks as verified.
YOYO_BILLING_PROVIDER=
YOYO_BILLING_CHECKOUT_URL=

# Production URL used by provider-neutral scheduled workflows and smoke checks.
YOYO_PRODUCTION_URL=
